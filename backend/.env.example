# Copy to backend/.env and adjust. Every value here has a working default,
# so Wirewise runs with no .env file at all.

# --- Django ---
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Absolute path of the SQLite file. Defaults to backend/db.sqlite3.
DJANGO_DB_PATH=

# --- Frontend access ---
# Origins allowed to call the API (the Vite dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# --- Import limits ---
IMPORT_MAX_UPLOAD_BYTES=10485760

# --- Optional Airtable sync for needs_review transactions (Section 10 bonus) ---
# Leave AIRTABLE_ENABLED=False and the sync is skipped entirely.
AIRTABLE_ENABLED=False
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Needs Review
AIRTABLE_TIMEOUT_SECONDS=5
